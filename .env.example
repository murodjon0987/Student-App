# PostgreSQL connection string.
# Lokal: postgresql://postgres:postgres@localhost:5432/studentapp?schema=public
# Bulut (bepul): https://neon.tech dan oling
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studentapp?schema=public"

# Session (JWT) imzolash uchun maxfiy kalit. `openssl rand -base64 32` bilan yarating.
SESSION_SECRET="change-me-in-production"

# Public application origin (HTTPS in production). Never derived from a request Host header.
APP_URL="http://localhost:3000"
# Verified sender and API key for password recovery email (https://resend.com/docs).
RESEND_API_KEY=""
EMAIL_FROM=""
# Only enable when a trusted reverse proxy replaces x-forwarded-for; Vercel is automatic.
# TRUST_PROXY="1"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
# Ixtiyoriy: model nomi (standart: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# Rasm generatsiyasi.
# Provayder: auto (avval Gemini, bo'lmasa Pollinations) | gemini | pollinations
# AI_IMAGE_PROVIDER="auto"
# O'chirish uchun: AI_IMAGE_DISABLED="1"
# Gemini rasm modellari billing talab qiladi (bepul kvota 0).
# Pollinations bepul, lekin anonim rejimda sekin (15s/so'rov). Token olsangiz:
# https://auth.pollinations.ai  ->  POLLINATIONS_TOKEN=""
# POLLINATIONS_TOKEN=""
# POLLINATIONS_MODEL="sana"
# O'lcham (standart: 1024x1024)
# POLLINATIONS_IMAGE_WIDTH="1024"
# POLLINATIONS_IMAGE_HEIGHT="1024"
# Promptni boyitish uchun Gemini matn modeli (standart: gemini-3.1-flash-lite)
# GEMINI_IMAGE_PROMPT_MODEL="gemini-3.1-flash-lite"

# Web Push (VAPID) — yangilanish bildirishnomalari.
# Yangi kalit yaratish: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Deploy paytida barcha foydalanuvchilarga "yangilanish" push yuborish.
# Vercel production deploy'da avtomatik. Lokal build'da yoqish uchun: NOTIFY_ON_BUILD="1"
# NOTIFY_ON_BUILD="1"

# Vercel Cron (kunlik eslatma). `openssl rand -base64 32` bilan yarating.
CRON_SECRET=""

NODE_ENV="development"
