// Student Super App — Prisma schema
// Barcha entity'lar foydalanuvchiga (User) bog'langan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & profile
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  name         String
  avatarUrl    String?
  role         String    @default("STUDENT")
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile           StudentProfile?
  subjects          Subject[]
  schedules         Schedule[]
  tasks             Task[]
  homeworks         Homework[]
  notes             Note[]
  exams             Exam[]
  events            Event[]
  expenses          Expense[]
  budgets           Budget[]
  goals             Goal[]
  studySessions     StudySession[]
  notifications     Notification[]
  materials         Material[]
  passwordResets    PasswordResetToken[]
  attachments       Attachment[]
  grades            Grade[]
  chats             Chat[]
  pushSubscriptions PushSubscription[]
  generatedImages   GeneratedImage[]
  housingListings   HousingListing[]
  housingFavorites  HousingFavorite[]

  @@index([email])
}

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university          String?
  faculty             String?
  course              Int?
  group               String?
  bio                 String?
  timezone            String   @default("Asia/Tashkent")
  language            String   @default("uz")
  theme               String   @default("system")
  notificationsEnabled Boolean @default(true)
  monthlyBudget       Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Academics
// ---------------------------------------------------------------------------

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  teacher   String?
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  schedules Schedule[]
  tasks     Task[]
  homeworks Homework[]
  notes     Note[]
  exams     Exam[]
  materials Material[]
  sessions  StudySession[]

  @@index([userId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String
  teacher   String?
  room      String?
  dayOfWeek Int // 1 = Dushanba ... 7 = Yakshanba
  startTime String // "09:00"
  endTime   String // "10:30"
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  @@index([userId, dayOfWeek])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  category    String?
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, deadline])
}

model Homework {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments Attachment[]

  @@index([userId, status])
  @@index([userId, deadline])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String
  content   String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([userId])
}

model Exam {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title        String
  date         DateTime
  time         String?
  room         String?
  description  String?
  prepProgress Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("PERSONAL") // CLASS | HOMEWORK | EXAM | DEADLINE | GOAL | PERSONAL
  start       DateTime
  end         DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  @@index([userId, start])
}

model Material {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  category    String   @default("OTHER") // PROGRAMMING | MATHEMATICS | PHYSICS | ENGLISH | OTHER
  url         String?
  description String?
  createdAt   DateTime @default(now())

  attachments Attachment[]

  @@index([userId, category])
}

model Attachment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  url        String
  type       String?
  size       Int?
  homeworkId String?
  homework   Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  noteId     String?
  note       Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  category    String   @default("OTHER") // FOOD | TRANSPORT | STUDY | INTERNET | SHOPPING | ENTERTAINMENT | OTHER
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // "2026-10"
  amount    Float
  createdAt DateTime @default(now())

  @@unique([userId, month])
}

// ---------------------------------------------------------------------------
// Goals & productivity
// ---------------------------------------------------------------------------

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  color       String     @default("#6366f1")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks GoalTask[]

  @@index([userId])
}

model GoalTask {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([goalId])
}

model StudySession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  durationMin Int
  mode        String? // POMODORO_25 | POMODORO_50 | POMODORO_90 | CUSTOM
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | REMINDER | WARNING | SUCCESS
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Grade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectName String
  credit      Float    @default(3)
  grade       String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// AI Assistant
// ---------------------------------------------------------------------------

model Chat {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Yangi suhbat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String   @default("image/png")
  data      Bytes
  prompt    String?
  provider  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Housing / rental marketplace (talabalar uchun kvartiralar)
// ---------------------------------------------------------------------------

model HousingListing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("APARTMENT") // APARTMENT | ROOM | HOUSE | DORMITORY | SHARED
  title       String
  description String?
  price       Int
  currency    String   @default("UZS") // UZS | USD
  rooms       Int      @default(1)
  area        Float?
  floor       Int?
  totalFloors Int?
  city        String
  district    String?
  address     String?
  lat         Float
  lng         Float
  phone       String?
  telegram    String?
  amenities   String[] @default([])
  status      String   @default("ACTIVE") // ACTIVE | RENTED | ARCHIVED
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images    HousingImage[]
  favorites HousingFavorite[]

  @@index([city])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model HousingImage {
  id        String         @id @default(cuid())
  listingId String
  listing   HousingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mimeType  String         @default("image/jpeg")
  data      Bytes
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([listingId])
}

model HousingFavorite {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   HousingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Public transport (Toshkent metro + avtobus)
// ---------------------------------------------------------------------------

enum TransportMode {
  METRO
  BUS
  TRAM
  TROLLEYBUS
}

model TransitStop {
  id           String        @id @default(cuid())
  city         String        @default("Tashkent")
  mode         TransportMode
  name         String
  nameUz       String?
  nameRu       String?
  nameEn       String?
  lat          Float
  lng          Float
  osmType      String?
  osmId        String?
  wikidataId   String?
  imageUrl     String?
  imageAuthor  String?
  imageLicense String?
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lineStops TransitLineStop[]

  @@unique([osmType, osmId])
  @@index([city, mode])
  @@index([name])
}

model TransitLine {
  id        String        @id @default(cuid())
  city      String        @default("Tashkent")
  mode      TransportMode
  ref       String
  name      String
  nameUz    String?
  color     String        @default("#6366f1")
  operator  String?
  geometry  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  stops TransitLineStop[]

  @@unique([city, mode, ref])
  @@index([city, mode])
}

model TransitLineStop {
  id       String      @id @default(cuid())
  lineId   String
  line     TransitLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stopId   String
  stop     TransitStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  sequence Int

  @@unique([lineId, sequence])
  @@index([stopId])
}

model TransitFare {
  id            String        @id @default(cuid())
  city          String        @default("Tashkent")
  mode          TransportMode
  amount        Float
  currency      String        @default("UZS")
  note          String?
  source        String?
  effectiveFrom DateTime?
  updatedAt     DateTime      @updatedAt

  @@unique([city, mode])
}
